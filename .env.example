# LLM provider
OPENAI_API_KEY=sk-...

# Vector store (Chroma is local and needs no keys — leave blank to use it)
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=data/chroma_db

# Only needed if you swap VECTOR_STORE to "pinecone"
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-assistant

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-assistant
